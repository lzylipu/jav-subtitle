# ---------- 必填 ----------
# 宿主机上放影片的目录（绝对路径）
MEDIA_DIR=/absolute/path/to/videos
# Web UI 登录密码（Basic 认证，浏览器会弹框）
WEB_PASSWORD=change-this-to-a-long-random-password

# ---------- 翻译接口（可全部留空，启动后在 Web UI「设置」里填）----------
# 这里刻意不写任何密钥：项目里不含 key，不写进 .env，也不进镜像。
OPENAI_BASE_URL=
OPENAI_MODEL=
OPENAI_API_KEY=

# ---------- 并发：默认全部 1，先在 UI 里跑顺再往上加 ----------
ASR_WORKERS=1
TRANSLATE_WORKERS=1
EXTRACT_WORKERS=1

# ---------- 限流：保护中转站，别把 key 打爆 ----------
# 每分钟最多请求数，0 表示不限制
TRANSLATE_RPM=20
# 两次请求的最小间隔（秒），实际取「60/rpm」和它的较大值
TRANSLATE_MIN_INTERVAL=3

# ---------- 成本闸门 ----------
# 每日翻译字数上限，0 表示不限制（防几千部片子把余额烧穿）
DAILY_CHAR_BUDGET=0
